{
  "manifest_version": 3,
  "name": "LocalFirst Knowledge Base",
  "description": "A privacy-first, offline Chrome extension to save and chat with web knowledge.",
  "version": "1.0",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "activeTab",
    "ai"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "64": "assets/icon-64.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "64": "assets/icon-64.png",
    "128": "assets/icon-128.png"
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Save page to LocalFirst KB"
    }
  }
}
